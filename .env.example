# Predator Guard - environment template. Copy to apps/web/.env.local
# (Next only loads env from the app directory). App runs with NO config:
# in development simulator mode fills in fake credentials.

# ---- Real Ring credentials ----
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_KEY=

# ---- Fastest path: one pasted access token ----
# NEVER paste a real value into this tracked file - GitHub push
# protection blocks it. Real values go in apps/web/.env.local.
# RING_ACCESS_TOKEN=

# ---- Optional model keys ----
# OPENROUTER_API_KEY=

# ---- Animal identification (F5, OpenCode - one call per capture) ----
# Ring says "animal"; this tells the owner WHAT animal. Real key ONLY
# in apps/web/.env.local. Unset => no call, captures stay pending.
# OPENCODE_API_KEY=
# OPENCODE_VISION_MODEL=claude-sonnet-4-5
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# ---- Token vault ----
TOKEN_ENC_KEY=

# ---- Mode / Database ----
# RING_SIM=
# DATABASE_URL=postgres://predator_guard:predator_guard@localhost:5432/predator_guard
# PGLITE_DATA_DIR=
